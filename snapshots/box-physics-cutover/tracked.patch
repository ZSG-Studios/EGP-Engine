-void ReplicationEditor::_pick_node_select_recursive(TreeItem *p_item, const String &p_filter, Vector<Node *> &p_select_candidates) {
-	if (!p_item) {
-		return;
-	}
-
-	NodePath np = p_item->get_metadata(0);
