extends Node

var checks := 0
var failed := false

func check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		push_error(message)
		failed = true

func _ready() -> void:
	var buffer: RefCounted = ClassDB.instantiate("EGPNetSnapshotInterpolator")
	check(buffer != null, "Native presentation backend missing")
	check(buffer.configure(60.0, 0.2, 0.1) == OK, "Configuration")
	check(buffer.configure(NAN, 0.2, 0.1) == ERR_INVALID_PARAMETER, "Reject nonfinite clock")
	check(buffer.submit(1, 60, Transform3D(Basis.IDENTITY, Vector3.ZERO), Vector3(6, 0, 0)), "First snapshot")
	check(is_equal_approx(buffer.get_statistics().buffer_ticks, 12.0), "Initial configured delay")
	check(not buffer.submit(1, 9007199254740992, Transform3D.IDENTITY, Vector3.ZERO), "Reject ticks beyond exact presentation precision")
	check(not buffer.submit(1, 59, Transform3D.IDENTITY, Vector3.ZERO), "Reject reordered snapshot")
	check(not buffer.submit(1, 61, Transform3D(Basis.IDENTITY, Vector3(NAN, 0, 0)), Vector3.ZERO), "Reject nonfinite snapshot")
	buffer.submit(1, 66, Transform3D(Basis.IDENTITY, Vector3(0.6, 0, 0)), Vector3(6, 0, 0))
	var previous: float = buffer.advance(0.0)
	for frame in 120:
		var current: float = buffer.advance(1.0 / 60.0)
		check(current >= previous and current <= 66, "Playback monotonic and bounded during outage")
		previous = current
	check(buffer.sample(1).origin.is_equal_approx(Vector3(0.6, 0, 0)), "Outage never drifts beyond newest authority")
	buffer.clear()
	buffer.submit(1, 100, Transform3D.IDENTITY, Vector3(6, 0, 0))
	buffer.submit(2, 130, Transform3D.IDENTITY, Vector3.ZERO)
	for frame in 60: buffer.advance(1.0 / 60.0)
	var before: Transform3D = buffer.sample(1)
	check(is_equal_approx(before.origin.x, 0.6), "Sparse entity extrapolation capped")
	buffer.submit(1, 130, Transform3D(Basis.IDENTITY, Vector3(1, 0, 0)), Vector3.ZERO)
	check(buffer.sample(1).origin.is_equal_approx(before.origin), "Late interest re-entry preserves display position")
	check(buffer.get_statistics().corrections == 1, "Correction diagnostics")
	check(buffer.get_statistics().entities[1].corrections == 1 and buffer.get_statistics().entities[2].corrections == 0, "Per-entity correction diagnostics remain isolated")
	for frame in 120: buffer.sample(1, 1.0 / 60.0)
	check(buffer.sample(1).origin.distance_to(Vector3(1, 0, 0)) < 0.001, "Presentation correction converges")
	buffer.submit(1, 131, Transform3D(Basis.IDENTITY, Vector3(20, 0, 0)), Vector3.ZERO)
	check(buffer.sample(1).origin.is_equal_approx(Vector3(20, 0, 0)), "Teleport clears interpolation and correction")
	check(buffer.get_statistics().teleports == 1, "Teleport diagnostics")
	buffer.remove(1)
	check(buffer.get_statistics().tracked_entities == 1, "Despawn frees bounded history")
	buffer.clear()
	buffer.configure(60, 0, 0)
	buffer.submit(1, 0, Transform3D.IDENTITY, Vector3.ZERO)
	buffer.submit(1, 6, Transform3D(Basis(Vector3.UP, PI / 2), Vector3(0.6, 0, 0)), Vector3.ZERO)
	var rotation_tick: float = buffer.advance(0.05)
	var mid: Transform3D = buffer.sample(1)
	check(absf(mid.origin.x - rotation_tick * 0.1) < 0.0001, "Position interpolates on tick timeline")
	check(absf(mid.basis.get_rotation_quaternion().get_angle() - rotation_tick / 6.0 * PI / 2) < 0.001, "Quaternion interpolation is smooth")
	var unchanged: float = buffer.advance(NAN)
	check(is_equal_approx(unchanged, rotation_tick), "Nonfinite delta preserves clock")
	buffer.clear()
	check(buffer.get_statistics().tracked_entities == 0 and buffer.get_statistics().corrections == 0, "Reconnect reset")
	# A late sparse snapshot must preserve rotation as well as position. Use
	# different axes so a quaternion composition-order mistake is observable.
	buffer.configure(60, 0.2, 0.1)
	var old_rotation := Quaternion(Vector3.RIGHT, PI / 2)
	var new_rotation := Quaternion(Vector3.UP, PI / 2)
	var replicated_scale := Vector3(2, 3, 4)
	buffer.submit(1, 100, Transform3D(Basis(old_rotation).scaled_local(replicated_scale), Vector3.ZERO), Vector3.ZERO)
	buffer.submit(2, 130, Transform3D.IDENTITY, Vector3.ZERO)
	for frame in 60: buffer.advance(1.0 / 60.0)
	var old_pose: Transform3D = buffer.sample(1)
	buffer.submit(1, 130, Transform3D(Basis(new_rotation).scaled_local(replicated_scale), Vector3.ZERO), Vector3.ZERO)
	var corrected_pose: Transform3D = buffer.sample(1)
	check(corrected_pose.basis.get_rotation_quaternion().angle_to(old_pose.basis.get_rotation_quaternion()) < 0.001, "Sparse rotational re-entry preserves displayed orientation")
	check(corrected_pose.basis.get_scale().is_equal_approx(replicated_scale), "Rotational correction preserves nonuniform transform scale")
	for frame in 120: buffer.sample(1, 1.0 / 60.0)
	var settled_pose: Transform3D = buffer.sample(1)
	check(settled_pose.basis.get_rotation_quaternion().angle_to(new_rotation) < 0.001, "Rotational correction converges to authority")
	check(buffer.get_statistics().entities[1].largest_angular_correction_degrees > 90, "Per-entity rotational correction diagnostics")
	buffer.configure(60, 0.2, 0.1)
	var wrap_old := Quaternion(Vector3.UP, deg_to_rad(179.0))
	var wrap_new := Quaternion(Vector3.UP, deg_to_rad(-179.0))
	buffer.submit(1, 100, Transform3D(Basis(wrap_old), Vector3.ZERO), Vector3.ZERO)
	buffer.submit(2, 130, Transform3D.IDENTITY, Vector3.ZERO)
	for frame in 60: buffer.advance(1.0 / 60.0)
	buffer.sample(1)
	buffer.submit(1, 130, Transform3D(Basis(wrap_new), Vector3.ZERO), Vector3.ZERO)
	var prior_rotation: Quaternion = buffer.sample(1).basis.get_rotation_quaternion()
	var largest_rotation_step := 0.0
	for frame in 120:
		var current_pose: Transform3D = buffer.sample(1, 1.0 / 60.0)
		var current_rotation: Quaternion = current_pose.basis.get_rotation_quaternion()
		largest_rotation_step = maxf(largest_rotation_step, prior_rotation.angle_to(current_rotation))
		prior_rotation = current_rotation
	check(largest_rotation_step < deg_to_rad(1.0) and prior_rotation.angle_to(wrap_new) < 0.001, "Rotation wraparound takes the short arc without a full turn")
	var teleport_rotation := Quaternion(Vector3.FORWARD, deg_to_rad(35.0))
	buffer.submit(1, 131, Transform3D(Basis(teleport_rotation), Vector3(20, 0, 0)), Vector3.ZERO)
	check(buffer.sample(1).basis.get_rotation_quaternion().angle_to(teleport_rotation) < 0.001, "Teleport clears angular correction")
	buffer.clear()
	for entity in range(1, 1025): buffer.submit(entity, 10, Transform3D.IDENTITY, Vector3.ZERO)
	check(buffer.get_statistics().tracked_entities == 1024, "Track capacity")
	check(not buffer.submit(1025, 10, Transform3D.IDENTITY, Vector3.ZERO), "Reject capacity overflow")
	check(not buffer.submit(1, 10, Transform3D.IDENTITY, Vector3.ZERO), "Duplicate sample rejected")
	if not failed: print("SNAPSHOT_INTERPOLATION_PASS checks=%d" % checks)
	get_tree().quit(1 if failed else 0)
