-	GodotJacobianEntry3D(
-			const Basis &world2A,
-			const Basis &world2B,
-			const Vector3 &rel_pos1, const Vector3 &rel_pos2,
-			const Vector3 &jointAxis,
-			const Vector3 &inertiaInvA,
