-	if (c_max == 0) {
-		return;
-	}
-
-	Contact *c = contacts.ptrw();
-
-	int idx = -1;
-
-	if (contact_count < c_max) {
-		idx = contact_count++;
-	} else {
-		real_t least_depth = 1e20;
-		int least_deep = -1;
