-Quat Quat::GetTwist(Vec3Arg inAxis) const
-{
-	Quat twist(Vec4(GetXYZ().Dot(inAxis) * inAxis, GetW()));
-	float twist_len = twist.LengthSq();
-	if (twist_len != 0.0f)
-		return twist / Sqrt(twist_len);
-	else
-		return Quat::sIdentity();
-}
