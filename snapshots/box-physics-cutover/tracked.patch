-		Vec3 x1(mVertices[v.mVertex[0]].mPosition);
-		Vec3 x2(mVertices[v.mVertex[1]].mPosition);
-		Vec3 x3(mVertices[v.mVertex[2]].mPosition);
-		Vec3 x4(mVertices[v.mVertex[3]].mPosition);
