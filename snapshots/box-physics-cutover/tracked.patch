-							to_process_triangles.push_back(&node_list.back());
-					}
-				}
-				else
-				{
-					// Add triangles
-					node_data->mTriangleStart = tri_ctx.Pack(&inTriangles[node_data->mNode->mTrianglesBegin], node_data->mNode->mNumTriangles, inStoreUserData, mTree, outError);
