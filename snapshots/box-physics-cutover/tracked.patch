-int Vec4::GetHighestComponentIndex() const
-{
-	// Get the maximum value in all 4 components
-	Vec4 value = Vec4::sMax(*this, Swizzle<SWIZZLE_Y, SWIZZLE_X, SWIZZLE_W, SWIZZLE_Z>());
