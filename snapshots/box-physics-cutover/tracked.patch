-	mRangeBlocks = reinterpret_cast<RangeBlock *>(data);
-	mHeightSamples = reinterpret_cast<uint8 *>(mRangeBlocks + mRangeBlocksSize);
-	mActiveEdges = mHeightSamples + mHeightSamplesSize;
-}
