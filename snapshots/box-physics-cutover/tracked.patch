-
-	if (is_axis_locked(PS3DE::BODY_AXIS_LINEAR_Y)) {
-		allowed_dofs &= ~JPH::EAllowedDOFs::TranslationY;
-	}
-
-	if (is_axis_locked(PS3DE::BODY_AXIS_LINEAR_Z)) {
-		allowed_dofs &= ~JPH::EAllowedDOFs::TranslationZ;
