-		{
-			JPH_ASSERT(IsValid());
-
-			do
-			{
-				++mIndex;
-			}
-			while (mIndex < mTable->mMaxSize && (mTable->mControl[mIndex] & cBucketUsed) == 0);
-
-			return static_cast<Iterator &>(*this);
-		}
-
-		/// Postfix increment
