-	const Vector3 *vertices = mesh.vertices.ptr();
-
-	Vector3 n = p_end - p_begin;
-	real_t min = 1e20;
-	bool col = false;
-
-	for (int i = 0; i < fc; i++) {
-		if (faces[i].plane.normal.dot(n) > 0) {
-			continue; //opposing face
-		}
-
-		int ic = faces[i].indices.size();
-		const int *ind = faces[i].indices.ptr();
