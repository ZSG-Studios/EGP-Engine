// Same-epoch structural coverage and transactional checkpoint-base replacement.
namespace {
struct ReplacementRow {CheckpointReplacementProgress progress;CoordinatorBootIdentity boot;};
Status valid_replacement(const CheckpointReplacementRequest& r,std::uint64_t match) noexcept {
    if(!r.operation_epoch||r.candidate.match!=match||r.retiring.match!=match||!r.candidate.id||!r.retiring.id||!r.candidate.generation||!r.retiring.generation||r.candidate==r.retiring)return fail(Error::InvalidArgument);return {};
}
Status write_ticket(Writer& out,CheckpointTicket t) noexcept {for(auto v:{t.match,t.id,t.generation})if(auto r=out.u64(v);!r)return r;return {};}
Result<CheckpointTicket> read_ticket(Reader& in) noexcept {auto m=in.u64(),i=in.u64(),g=in.u64();if(!m||!i||!g||!*m||!*i||!*g)return fail(Error::RecoveryUnavailable);return CheckpointTicket{*m,*i,*g};}
std::array<std::byte,64> replacement_identity(const CheckpointReplacementRequest& r) noexcept {std::array<std::byte,64> bytes{};Writer w(bytes);(void)w.u64(r.operation_epoch);(void)w.u64(r.operation);(void)write_ticket(w,r.candidate);(void)write_ticket(w,r.retiring);return bytes;}
Status replacement_tables(sqlite3* db) noexcept {return execute(db,"CREATE TABLE IF NOT EXISTS checkpoint_replacement_head(match BLOB PRIMARY KEY,epoch BLOB NOT NULL CHECK(length(epoch)=8),through BLOB CHECK(through IS NULL OR length(through)=8)) WITHOUT ROWID;CREATE TABLE IF NOT EXISTS checkpoint_replacements(match BLOB NOT NULL,operation BLOB NOT NULL,request BLOB NOT NULL CHECK(length(request)=64),survivor BLOB NOT NULL CHECK(length(survivor)=24),revision BLOB NOT NULL CHECK(length(revision)=8),boot BLOB NOT NULL CHECK(length(boot)=40),scanned BLOB NOT NULL CHECK(length(scanned)=8),target BLOB NOT NULL CHECK(length(target)=8),records BLOB NOT NULL CHECK(length(records)=8),bytes BLOB NOT NULL CHECK(length(bytes)=8),digest BLOB NOT NULL CHECK(length(digest)=32),state INTEGER NOT NULL CHECK(state IN(0,1,2)),PRIMARY KEY(match,operation)) WITHOUT ROWID;");}
struct ReplacementHead {std::uint64_t epoch{};std::optional<std::uint64_t> through;};
Result<ReplacementHead> replacement_head(sqlite3* db,std::uint64_t match) noexcept {
    auto exists=service_table_exists(db,"checkpoint_replacement_head");if(!exists)return fail(exists.error());if(!*exists)return fail(Error::NotReady);
    Statement row;if(auto r=row.prepare(db,"SELECT epoch,through FROM checkpoint_replacement_head WHERE match=?1");!r)return fail(r.error());if(auto r=row.number(1,match);!r)return fail(r.error());auto code=sqlite3_step(row.value);if(code==SQLITE_DONE)return fail(Error::NotReady);if(code!=SQLITE_ROW)return fail(sql_error(code));auto epoch=row.number(0);if(!epoch||!*epoch)return fail(Error::RecoveryUnavailable);ReplacementHead head{*epoch,{}};if(sqlite3_column_type(row.value,1)!=SQLITE_NULL){auto value=row.number(1);if(!value)return fail(value.error());head.through=*value;}return head;
}
Status finish_replacement(sqlite3* db,const CheckpointReplacementRequest& request,unsigned state) noexcept {
    auto head=replacement_head(db,request.candidate.match);if(!head)return fail(head.error());if(head->epoch!=request.operation_epoch)return fail(Error::StaleEpoch);if(head->through&&*head->through==UINT64_MAX)return fail(Error::CounterExhausted);if(request.operation!=(head->through?*head->through+1:0))return fail(Error::StaleGeneration);
    Statement terminal;if(auto r=terminal.prepare(db,"UPDATE checkpoint_replacements SET state=?3 WHERE match=?1 AND operation=?2 AND state=0");!r)return r;if(!terminal.number(1,request.candidate.match)||!terminal.number(2,request.operation)||sqlite3_bind_int(terminal.value,3,static_cast<int>(state))!=SQLITE_OK)return fail(Error::Io);if(sqlite3_step(terminal.value)!=SQLITE_DONE||sqlite3_changes(db)!=1)return fail(Error::StaleGeneration);
    Statement update;if(auto r=update.prepare(db,"UPDATE checkpoint_replacement_head SET through=?2 WHERE match=?1");!r)return r;if(!update.number(1,request.candidate.match)||!update.number(2,request.operation))return fail(Error::Io);if(sqlite3_step(update.value)!=SQLITE_DONE||sqlite3_changes(db)!=1)return fail(Error::RecoveryUnavailable);
    if(request.operation>=checkpoint_replacement_cache){Statement prune;if(auto r=prune.prepare(db,"DELETE FROM checkpoint_replacements WHERE match=?1 AND operation<=?2 AND state<>0");!r)return r;if(!prune.number(1,request.candidate.match)||!prune.number(2,request.operation-checkpoint_replacement_cache))return fail(Error::Io);if(sqlite3_step(prune.value)!=SQLITE_DONE)return fail(Error::Io);}return {};
}
template<class Store> Result<ReplacementRow> replacement_row(Store& s,const CheckpointReplacementRequest& request) noexcept {
    if(auto r=valid_replacement(request,s.config.match);!r)return fail(r.error());auto head=replacement_head(s.database,s.config.match);if(!head)return fail(head.error());if(head->epoch!=request.operation_epoch)return fail(Error::StaleEpoch);const bool retired=head->through&&request.operation<=*head->through;if(!retired){if(head->through&&*head->through==UINT64_MAX)return fail(Error::CounterExhausted);if(request.operation!=(head->through?*head->through+1:0))return fail(Error::ProtocolViolation);}auto exists=service_table_exists(s.database,"checkpoint_replacements");if(!exists)return fail(exists.error());if(!*exists)return fail(Error::NotReady);
    Statement row;if(auto r=row.prepare(s.database,"SELECT request,survivor,revision,boot,scanned,target,records,bytes,digest,state FROM checkpoint_replacements WHERE match=?1 AND operation=?2");!r)return fail(r.error());if(auto r=row.number(1,s.config.match);!r)return fail(r.error());if(auto r=row.number(2,request.operation);!r)return fail(r.error());auto code=sqlite3_step(row.value);if(code==SQLITE_DONE){if(retired){ReplacementRow result;result.progress.request=request;result.progress.state=CheckpointReplacementState::Retired;return result;}return fail(Error::NotReady);}if(code!=SQLITE_ROW)return fail(sql_error(code));
    auto identity=sqlite_blob(row.value,0,64,64),survivor=sqlite_blob(row.value,1,24,24),boot=sqlite_blob(row.value,3,40,40),digest=sqlite_blob(row.value,8,32,32);if(!identity||!survivor||!boot||!digest)return fail(Error::RecoveryUnavailable);if(!std::equal(identity->begin(),identity->end(),replacement_identity(request).begin()))return fail(Error::ProtocolViolation);
    auto revision=row.number(2),scanned=row.number(4),target=row.number(5),records=row.number(6),bytes=row.number(7),state=checkpoint_integer(row.value,9,2);if(!revision||!scanned||!target||!records||!bytes||!state||*scanned>*target)return fail(Error::RecoveryUnavailable);
    Reader sr(*survivor),br(*boot);auto ticket=read_ticket(sr);auto term=br.u64();auto nonce=br.raw(32);if(!ticket||ticket->match!=s.config.match||*ticket==request.candidate||*ticket==request.retiring||!term||!nonce)return fail(Error::RecoveryUnavailable);
    ReplacementRow result;result.progress={request,*ticket,*revision,*scanned,*target,*records,*bytes,*scanned==*target,{},*state==2?CheckpointReplacementState::Cancelled:(*state?CheckpointReplacementState::Committed:CheckpointReplacementState::Scanning)};result.boot.term=*term;std::copy(nonce->begin(),nonce->end(),result.boot.nonce.begin());std::copy(digest->begin(),digest->end(),result.progress.commitment.begin());if(!known_fingerprint(result.progress.commitment))return fail(Error::RecoveryUnavailable);
    if(*state==1){if(!result.progress.complete)return fail(Error::RecoveryUnavailable);auto image=checkpoint_row(s,request.candidate.id);if(!image){if(image.error()!=Error::NotReady)return fail(image.error());result.progress.state=CheckpointReplacementState::Retired;}else if(image->ticket!=request.candidate)result.progress.state=CheckpointReplacementState::Retired;else if(image->state!=CheckpointContentState::RecoveryVerified)return fail(Error::RecoveryUnavailable);}
    if(bool(*state)!=retired)return fail(Error::RecoveryUnavailable);return result;
}
bool replacement_compatible(const CheckpointManifest& candidate,const CheckpointManifest& base) noexcept {return candidate.match==base.match&&candidate.epoch==base.epoch&&candidate.sequence>=base.sequence&&candidate.schemas==base.schemas&&candidate.simulation==base.simulation&&candidate.participants==base.participants&&candidate.service_codec==base.service_codec&&unsigned(candidate.grade)>=unsigned(base.grade);}
template<class Store> Result<CheckpointContentReceipt> replacement_guard(Store& s,const ReplacementRow& row) noexcept {
    auto candidate=checkpoint_row(s,row.progress.request.candidate.id),retiring=checkpoint_row(s,row.progress.request.retiring.id),survivor=checkpoint_row(s,row.progress.survivor.id);if(!candidate||!retiring||!survivor)return fail(Error::StaleGeneration);
    if(candidate->ticket!=row.progress.request.candidate||retiring->ticket!=row.progress.request.retiring||survivor->ticket!=row.progress.survivor||candidate->state!=CheckpointContentState::ContentVerified||retiring->state!=CheckpointContentState::RecoveryVerified||survivor->state!=CheckpointContentState::RecoveryVerified)return fail(Error::StaleGeneration);
    if(!replacement_compatible(candidate->manifest,retiring->manifest)||!replacement_compatible(candidate->manifest,survivor->manifest)||retiring->manifest.sequence>survivor->manifest.sequence||survivor->manifest.sequence>row.progress.scanned_through||candidate->manifest.sequence!=row.progress.target||row.progress.records!=row.progress.scanned_through-survivor->manifest.sequence)return fail(Error::RecoveryUnavailable);
    auto capture=service_capture_row(s,candidate->ticket);if(!capture)return fail(capture.error());if(!capture->progress.complete||capture->progress.revision!=row.progress.revision||capture->boot!=row.boot)return fail(Error::StaleGeneration);if(auto r=service_capture_guard(s,*candidate,*capture);!r)return fail(r.error());return candidate;
}
template<class Store> Result<Fingerprint> replacement_seed(Store& s,const CheckpointReplacementRequest& request,CheckpointTicket survivor,const ServiceCapture& capture,std::uint64_t base,std::uint64_t target) noexcept {
    std::array<std::byte,256> bytes{};Writer w(bytes);if(auto r=w.u64(0x53505245504c0001);!r)return fail(r.error());if(auto r=w.raw(replacement_identity(request));!r)return fail(r.error());if(auto r=write_ticket(w,survivor);!r)return fail(r.error());for(auto n:{capture.progress.revision,capture.boot.term,base,target})if(auto r=w.u64(n);!r)return fail(r.error());if(auto r=w.raw(capture.boot.nonce);!r)return fail(r.error());if(auto r=w.raw(capture.progress.commitment);!r)return fail(r.error());return checkpoint_hash(s,std::span(bytes).first(w.size()));
}
Status erase_checkpoint(sqlite3* db,CheckpointTicket ticket,CheckpointContentState state) noexcept {
    constexpr std::array<const char*,4> tables{"checkpoint_service_pages","checkpoint_service","checkpoint_chunks","checkpoint_images"};
    constexpr std::array<const char*,4> queries{"DELETE FROM checkpoint_service_pages WHERE match=?1 AND id=?2","DELETE FROM checkpoint_service WHERE match=?1 AND id=?2","DELETE FROM checkpoint_chunks WHERE match=?1 AND id=?2","DELETE FROM checkpoint_images WHERE match=?1 AND id=?2 AND generation=?3 AND state=?4"};
    for(unsigned i=0;i<tables.size();++i){auto exists=service_table_exists(db,tables[i]);if(!exists)return fail(exists.error());if(!*exists){if(i==3)return fail(Error::StaleGeneration);continue;}Statement remove;if(auto r=remove.prepare(db,queries[i]);!r)return r;if(auto r=remove.number(1,ticket.match);!r)return r;if(auto r=remove.number(2,ticket.id);!r)return r;if(i==3){if(auto r=remove.number(3,ticket.generation);!r)return r;if(sqlite3_bind_int(remove.value,4,static_cast<int>(state))!=SQLITE_OK)return fail(Error::Io);}if(sqlite3_step(remove.value)!=SQLITE_DONE)return fail(Error::Io);if(i==3&&sqlite3_changes(db)!=1)return fail(Error::StaleGeneration);}return {};
}
}
Result<CheckpointReplacementProgress> SqliteJournal::begin_checkpoint_replacement(const CheckpointReplacementRequest& request,bool restart) noexcept {
    if(!impl_||!impl_->own_thread())return fail(Error::PermissionDenied);auto& s=*impl_;if(!s.checkpoint_digest)return fail(Error::NotReady);if(auto r=valid_replacement(request,s.config.match);!r)return fail(r.error());Transaction tx{s.database};if(auto r=tx.begin();!r)return fail(r.error());if(auto r=replacement_tables(s.database);!r)return fail(r.error());
    auto head=replacement_head(s.database,s.config.match);if(!head){if(head.error()!=Error::NotReady)return fail(head.error());if(request.operation!=0)return fail(Error::ProtocolViolation);Statement init;if(auto r=init.prepare(s.database,"INSERT INTO checkpoint_replacement_head VALUES(?1,?2,NULL)");!r)return fail(r.error());if(!init.number(1,s.config.match)||!init.number(2,request.operation_epoch))return fail(Error::Io);if(sqlite3_step(init.value)!=SQLITE_DONE)return fail(Error::Io);}
    auto prior=replacement_row(s,request);if(prior&&(!restart||prior->progress.state!=CheckpointReplacementState::Scanning)){if(auto r=s.reconfirm();!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());return prior->progress;}if(!prior&&prior.error()!=Error::NotReady)return fail(prior.error());
    auto candidate=checkpoint_row(s,request.candidate.id),retiring=checkpoint_row(s,request.retiring.id);if(!candidate||!retiring)return fail(Error::StaleGeneration);if(candidate->ticket!=request.candidate||retiring->ticket!=request.retiring||candidate->state!=CheckpointContentState::ContentVerified||retiring->state!=CheckpointContentState::RecoveryVerified)return fail(Error::StaleGeneration);
    auto cut=service_capture_row(s,candidate->ticket);if(!cut)return fail(cut.error());if(!cut->progress.complete)return fail(Error::NotReady);if(auto r=service_capture_guard(s,*candidate,*cut);!r)return fail(r.error());
    Statement others;if(auto r=others.prepare(s.database,"SELECT id FROM checkpoint_images WHERE match=?1 AND state=2 AND id<>?2");!r)return fail(r.error());if(auto r=others.number(1,s.config.match);!r)return fail(r.error());if(auto r=others.number(2,request.retiring.id);!r)return fail(r.error());if(sqlite3_step(others.value)!=SQLITE_ROW)return fail(Error::NotReady);auto id=others.number(0);if(!id)return fail(id.error());auto survivor=checkpoint_row(s,*id);if(!survivor)return fail(survivor.error());if(sqlite3_step(others.value)!=SQLITE_DONE)return fail(Error::RecoveryUnavailable);
    if(!replacement_compatible(candidate->manifest,retiring->manifest)||!replacement_compatible(candidate->manifest,survivor->manifest)||retiring->manifest.sequence>survivor->manifest.sequence)return fail(Error::IncompatibleSchema);
    auto seed=replacement_seed(s,request,survivor->ticket,*cut,survivor->manifest.sequence,candidate->manifest.sequence);if(!seed)return fail(seed.error());std::array<std::byte,24> survivor_bytes{};Writer sw(survivor_bytes);if(auto r=write_ticket(sw,survivor->ticket);!r)return fail(r.error());std::array<std::byte,40> boot{};Writer bw(boot);if(auto r=bw.u64(cut->boot.term);!r)return fail(r.error());if(auto r=bw.raw(cut->boot.nonce);!r)return fail(r.error());
    Statement insert;if(auto r=insert.prepare(s.database,"INSERT INTO checkpoint_replacements VALUES(?1,?2,?3,?4,?5,?6,?7,?8,?9,?9,?10,0) ON CONFLICT(match,operation) DO UPDATE SET survivor=excluded.survivor,revision=excluded.revision,boot=excluded.boot,scanned=excluded.scanned,target=excluded.target,records=excluded.records,bytes=excluded.bytes,digest=excluded.digest,state=0");!r)return fail(r.error());for(auto [column,value]:{std::pair{1,s.config.match},{2,request.operation},{5,cut->progress.revision},{7,survivor->manifest.sequence},{8,candidate->manifest.sequence},{9,std::uint64_t{0}}})if(auto r=insert.number(column,value);!r)return fail(r.error());if(!insert.bytes(3,replacement_identity(request))||!insert.bytes(4,survivor_bytes)||!insert.bytes(6,boot)||!insert.bytes(10,*seed))return fail(Error::Io);if(sqlite3_step(insert.value)!=SQLITE_DONE)return fail(Error::Io);if(auto r=tx.commit();!r)return fail(r.error());
    return CheckpointReplacementProgress{request,survivor->ticket,cut->progress.revision,survivor->manifest.sequence,candidate->manifest.sequence,0,0,survivor->manifest.sequence==candidate->manifest.sequence,*seed,CheckpointReplacementState::Scanning};
}
Result<CheckpointReplacementProgress> SqliteJournal::query_checkpoint_replacement(const CheckpointReplacementRequest& request) noexcept {
    if(!impl_||!impl_->own_thread())return fail(Error::PermissionDenied);auto& s=*impl_;Transaction tx{s.database};if(auto r=tx.begin();!r)return fail(r.error());auto row=replacement_row(s,request);if(!row)return fail(row.error());if(auto r=s.reconfirm();!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());return row->progress;
}
Result<CheckpointReplacementProgress> SqliteJournal::capture_checkpoint_coverage(const CheckpointReplacementRequest& request) noexcept {
    if(!impl_||!impl_->own_thread())return fail(Error::PermissionDenied);auto& s=*impl_;if(!s.checkpoint_digest)return fail(Error::NotReady);Transaction tx{s.database};if(auto r=tx.begin();!r)return fail(r.error());auto row=replacement_row(s,request);if(!row)return fail(row.error());if(row->progress.state!=CheckpointReplacementState::Scanning){if(auto r=s.reconfirm();!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());return row->progress;}auto candidate=replacement_guard(s,*row);if(!candidate)return fail(candidate.error());
    if(row->progress.complete){if(auto r=s.reconfirm();!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());return row->progress;}
    Buffer page(*s.allocator,MemoryDomain::Recovery);if(auto r=page.resize(checkpoint_coverage_page_bytes);!r)return fail(r.error());Writer writer(page.bytes());Statement records;if(auto r=records.prepare(s.database,"SELECT r.append_id,r.epoch,r.seq,r.tick,r.data,e.envelope FROM records r LEFT JOIN commit_envelopes e ON e.match=r.match AND e.append_id=r.append_id WHERE r.match=?1 AND r.seq>?2 AND r.seq<=?3 ORDER BY r.seq LIMIT 64");!r)return fail(r.error());if(!records.number(1,s.config.match)||!records.number(2,row->progress.scanned_through)||!records.number(3,row->progress.target))return fail(Error::Io);
    std::uint64_t last=row->progress.scanned_through;std::uint32_t count=0;bool full=false;
    for(;;){auto code=sqlite3_step(records.value);if(code==SQLITE_DONE)break;if(code!=SQLITE_ROW)return fail(sql_error(code));auto id=records.number(0),epoch=records.number(1),sequence=records.number(2),tick=records.number(3);if(!id||!*id||!epoch||*epoch!=candidate->manifest.epoch||!sequence||last==UINT64_MAX||*sequence!=last+1||!tick||*tick>candidate->manifest.tick)return fail(Error::RecoveryUnavailable);auto canonical=sqlite_blob(records.value,4,0,s.config.maximum_record_bytes);if(!canonical)return fail(canonical.error());auto envelope=sqlite_blob(records.value,5,0,s.config.maximum_record_bytes-canonical->size());if(!envelope)return fail(envelope.error());auto decoded=decode_journal_envelope(s.config.match,*envelope);if(!decoded)return fail(decoded.error());
        const auto bytes=56+canonical->size()+envelope->size();if(bytes>page.size()-writer.size()){if(!count)return fail(Error::CapacityExceeded);full=true;break;}for(auto value:{s.config.match,*id,*epoch,*sequence,*tick,std::uint64_t(canonical->size()),std::uint64_t(envelope->size())})if(auto r=writer.u64(value);!r)return fail(r.error());if(auto r=writer.raw(*canonical);!r)return fail(r.error());if(auto r=writer.raw(*envelope);!r)return fail(r.error());last=*sequence;++count;
    }
    if(!count||(!full&&count<checkpoint_coverage_page_records&&last<row->progress.target))return fail(Error::RecoveryUnavailable);if(row->progress.records>UINT64_MAX-count||row->progress.bytes>UINT64_MAX-writer.size())return fail(Error::CounterExhausted);auto hash=checkpoint_hash(s,page.bytes().first(writer.size()));if(!hash)return fail(hash.error());std::array<std::byte,88> link{};Writer lw(link);if(auto r=lw.raw(row->progress.commitment);!r)return fail(r.error());for(auto n:{row->progress.scanned_through,last,std::uint64_t(writer.size())})if(auto r=lw.u64(n);!r)return fail(r.error());if(auto r=lw.raw(*hash);!r)return fail(r.error());auto root=checkpoint_hash(s,link);if(!root)return fail(root.error());
    Statement update;if(auto r=update.prepare(s.database,"UPDATE checkpoint_replacements SET scanned=?3,records=?4,bytes=?5,digest=?6 WHERE match=?1 AND operation=?2 AND state=0");!r)return fail(r.error());if(!update.number(1,s.config.match)||!update.number(2,request.operation)||!update.number(3,last)||!update.number(4,row->progress.records+count)||!update.number(5,row->progress.bytes+writer.size())||!update.bytes(6,*root))return fail(Error::Io);if(sqlite3_step(update.value)!=SQLITE_DONE||sqlite3_changes(s.database)!=1)return fail(Error::StaleGeneration);if(auto r=tx.commit();!r)return fail(r.error());row->progress.scanned_through=last;row->progress.records+=count;row->progress.bytes+=writer.size();row->progress.commitment=*root;row->progress.complete=last==row->progress.target;return row->progress;
}
Result<CheckpointReplacementProgress> SqliteJournal::replace_checkpoint(const CheckpointReplacementRequest& request,CheckpointParticipantVerifier& verifier) noexcept {
    if(!impl_||!impl_->own_thread())return fail(Error::PermissionDenied);auto& s=*impl_;if(!s.checkpoint_digest)return fail(Error::NotReady);Transaction tx{s.database};if(auto r=tx.begin();!r)return fail(r.error());auto row=replacement_row(s,request);if(!row)return fail(row.error());if(row->progress.state!=CheckpointReplacementState::Scanning){if(auto r=s.reconfirm();!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());return row->progress;}if(!row->progress.complete)return fail(Error::NotReady);auto candidate=replacement_guard(s,*row);if(!candidate)return fail(candidate.error());auto capture=service_capture_row(s,candidate->ticket);if(!capture)return fail(capture.error());if(auto r=verify_checkpoint_image(s,*candidate,*capture,verifier);!r)return fail(r.error());if(auto r=replacement_guard(s,*row);!r)return fail(r.error());
    Statement promote;if(auto r=promote.prepare(s.database,"UPDATE checkpoint_images SET state=2 WHERE match=?1 AND id=?2 AND generation=?3 AND state=1");!r)return fail(r.error());if(!promote.number(1,s.config.match)||!promote.number(2,candidate->ticket.id)||!promote.number(3,candidate->ticket.generation))return fail(Error::Io);if(sqlite3_step(promote.value)!=SQLITE_DONE||sqlite3_changes(s.database)!=1)return fail(Error::StaleGeneration);if(auto r=erase_checkpoint(s.database,request.retiring,CheckpointContentState::RecoveryVerified);!r)return fail(r.error());if(auto r=finish_replacement(s.database,request,1);!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());row->progress.state=CheckpointReplacementState::Committed;return row->progress;
}

Result<CheckpointReplacementProgress> SqliteJournal::cancel_checkpoint_replacement(const CheckpointReplacementRequest& request) noexcept {
    if(!impl_||!impl_->own_thread())return fail(Error::PermissionDenied);auto& s=*impl_;Transaction tx{s.database};if(auto r=tx.begin();!r)return fail(r.error());auto row=replacement_row(s,request);if(!row)return fail(row.error());if(row->progress.state==CheckpointReplacementState::Scanning){if(auto r=finish_replacement(s.database,request,2);!r)return fail(r.error());row->progress.state=CheckpointReplacementState::Cancelled;}else if(auto r=s.reconfirm();!r)return fail(r.error());if(auto r=tx.commit();!r)return fail(r.error());return row->progress;
}
