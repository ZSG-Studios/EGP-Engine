-			while (mIndex < mTable->mMaxSize && (mTable->mControl[mIndex] & cBucketUsed) == 0)
-				++mIndex;
-		}
-
-		/// Iterator at specific index
-							IteratorBase(Table *inTable, size_type inIndex) :
-			mTable(inTable),
-			mIndex(inIndex)
-		{
-		}
-
-		/// Prefix increment
