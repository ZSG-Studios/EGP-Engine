-	/// Note that validation is not compatible with restoring a simulation state in multiple parts.
-	void				SetIsLastPart(bool inIsLastPart)							{ mIsLastPart = inIsLastPart; }
-	bool				IsLastPart() const											{ return mIsLastPart; }
-
-private:
