-				v0.StoreFloat3(outTriangleVertices++);
-				(context.mTransform * mPoints[*(v - 1)].mPosition).StoreFloat3(outTriangleVertices++);
-				(context.mTransform * mPoints[*v].mPosition).StoreFloat3(outTriangleVertices++);
