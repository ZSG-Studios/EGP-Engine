-			inStream.Write(c->mConstraintIndex);
-			c->SaveState(inStream);
-		}
-	}
-	else
-	{
-		// Save all constraints
-		uint32 num_constraints = (uint32)mConstraints.size();
-		inStream.Write(num_constraints);
-		for (const Ref<Constraint> &c : mConstraints)
