-	// Set position
-	inV1.StoreFloat3(&mV[0].mPosition);
-	inV2.StoreFloat3(&mV[1].mPosition);
-	inV3.StoreFloat3(&mV[2].mPosition);
-
-	// Set color
-	mV[0].mColor = mV[1].mColor = mV[2].mColor = inColor;
-
-	// Calculate normal
