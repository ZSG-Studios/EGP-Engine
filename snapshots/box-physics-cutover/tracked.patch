-MassProperties CompoundShape::GetMassProperties() const
-{
-	MassProperties p;
-
-	// Calculate mass and inertia
-	p.mMass = 0.0f;
-	p.mInertia = Mat44::sZero();
-	for (const SubShape &shape : mSubShapes)
-	{
-		// Rotate and translate inertia of child into place
