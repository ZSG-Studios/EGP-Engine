-		return ApplyVelocityStep(ioBody1, ioBody2, inN1, inN2, inRatio, lambda);
-	}
-
-	/// Return lagrange multiplier
-	float						GetTotalLambda() const
-	{
-		return mTotalLambda;
-	}
