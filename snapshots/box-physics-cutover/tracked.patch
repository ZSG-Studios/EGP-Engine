-					const real_t b_dot_ba = vec3_dot(b->w, ba);
-
-					if (a_dot_ba > 0) {
-						// Pick distance vertex a
-						dist = a->w.length();
-					} else if (b_dot_ba < 0) {
-						// Pick distance vertex b
-						dist = b->w.length();
