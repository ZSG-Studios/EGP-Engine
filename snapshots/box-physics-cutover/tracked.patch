-			// Do nothing.
-		} else {
-			get_body_iface().DeactivateBody(p_jolt_id);
-		}
-	} else {
-		if (pending_objects_sleeping.erase_unordered(p_jolt_id)) {
-			pending_objects_awake.push_back(p_jolt_id);
-		} else if (pending_objects_awake.has(p_jolt_id)) {
