-	#else
-		Type shuf = _mm_movehdup_ps(mValue); // [y, y, w, w]
-		Type sums = _mm_add_ps(mValue, shuf); // [x + y, y + y, z + w, w + w]
-		shuf = _mm_movehl_ps(mValue, mValue); // [z, w, z, w]
-	#endif
