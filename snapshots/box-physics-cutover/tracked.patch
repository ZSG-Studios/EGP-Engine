-	}
-
-	for (Node &node : nodes) {
-		node.area = 0.0;
-	}
-
-	for (const Face &face : faces) {
-		for (int j = 0; j < 3; ++j) {
-			const int index = (int)(face.n[j] - &nodes[0]);
-			counts[index]++;
-			face.n[j]->area += Math::abs(face.ra);
-		}
-	}
