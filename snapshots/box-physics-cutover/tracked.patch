-
-Vector3 GodotSliderJoint3D::getAncorInA() {
-	Vector3 ancorInA;
-	ancorInA = m_realPivotAInW + (m_lowerLinLimit + m_upperLinLimit) * real_t(0.5) * m_sliderAxis;
-	ancorInA = A->get_transform().inverse().xform(ancorInA);
-	return ancorInA;
-}
