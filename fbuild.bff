// FASTBuild entry points. SCons owns EGP's generated files, resources and links;
// fastbuild=yes replaces its C/C++ actions with distributable ObjectLists.
.Root = '$_WORKING_DIR_$'
.Shell = 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'

Exec('egp-editor')
{
    .ExecExecutable = .Shell
    .ExecWorkingDir = .Root
    .ExecArguments = '-NoProfile -ExecutionPolicy Bypass -File "$Root$\misc\scripts\build_egp.ps1" -Target editor'
    .ExecOutput = '$Root$\.build\fastbuild\entry-editor.stamp'
    .ExecAlways = true
    .ExecAlwaysShowOutput = true
}
Exec('egp-template-debug')
{
    .ExecExecutable = .Shell
    .ExecWorkingDir = .Root
    .ExecArguments = '-NoProfile -ExecutionPolicy Bypass -File "$Root$\misc\scripts\build_egp.ps1" -Target template_debug'
    .ExecOutput = '$Root$\.build\fastbuild\entry-template_debug.stamp'
    .ExecAlways = true
    .ExecAlwaysShowOutput = true
}
Exec('egp-template-release')
{
    .ExecExecutable = .Shell
    .ExecWorkingDir = .Root
    .ExecArguments = '-NoProfile -ExecutionPolicy Bypass -File "$Root$\misc\scripts\build_egp.ps1" -Target template_release'
    .ExecOutput = '$Root$\.build\fastbuild\entry-template_release.stamp'
    .ExecAlways = true
    .ExecAlwaysShowOutput = true
}
// Run the targets sequentially: SCons and Mono glue share build metadata.
Exec('egp-all')
{
    .ExecExecutable = .Shell
    .ExecWorkingDir = .Root
    .ExecArguments = '-NoProfile -ExecutionPolicy Bypass -File "$Root$\misc\scripts\build_egp.ps1" -Target all'
    .ExecOutput = '$Root$\.build\fastbuild\entry-all.stamp'
    .ExecAlways = true
    .ExecAlwaysShowOutput = true
}
Alias('all') { .Targets = 'egp-all' }
