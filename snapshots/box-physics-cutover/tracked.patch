-			hull.DrawLabel("Next iteration");
-#endif
-#ifdef JPH_EPA_PENETRATION_DEPTH_DEBUG
-			Trace("EncapsulateOrigin: verts = (%d, %d, %d), closest_dist_sq = %g, centroid = (%g, %g, %g), normal = (%g, %g, %g)",
