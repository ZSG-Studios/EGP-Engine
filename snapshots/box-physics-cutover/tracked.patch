-void ConvexHullBuilder2D::AssignPointToEdge(int inPositionIdx, const Array<Edge *> &inEdges) const
-{
-	Vec3 point = mPositions[inPositionIdx];
-
-	Edge *best_edge = nullptr;
-	float best_dist_sq = 0.0f;
-
