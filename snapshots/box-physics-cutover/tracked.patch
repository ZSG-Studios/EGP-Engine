-					&& mFrictionConstraint1.GetTotalLambda() == 0.0f
-					&& mFrictionConstraint2.GetTotalLambda() == 0.0f
-					&& mAngularFrictionConstraint.GetTotalLambda() == 0.0f? 0.1f :  0.2f;
