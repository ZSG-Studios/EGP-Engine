-
-	inStream.Read(mOffset);
-	inStream.Read(mScale);
-	inStream.Read(mSampleCount);
-	inStream.Read(mBlockSize);
-	inStream.Read(mBitsPerSample);
-	inStream.Read(mMinSample);
-	inStream.Read(mMaxSample);
