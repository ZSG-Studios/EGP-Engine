-{
-	// Ensure string empty
-	outString.clear();
-
-	for (const String &s : inVector)
-	{
-		// Add delimiter if not first element
-		if (!outString.empty())
-			outString.append(inDelimiter);
-
-		// Add element
-		outString.append(s);
-	}
-}
-
-String ToLower(const string_view &inString)
-{
-	String out;
-	out.reserve(inString.length());
-	for (char c : inString)
-		out.push_back((char)tolower(c));
-	return out;
-}
