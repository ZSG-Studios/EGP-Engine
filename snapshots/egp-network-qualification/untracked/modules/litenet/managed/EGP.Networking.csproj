<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);LITENETLIB_UNSAFE;SIMULATE_NETWORK</DefineConstants>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageId>EGP.Networking</PackageId>
    <Version>0.1.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>EGP authoritative LiteNetLib and LiteEntitySystem runtime.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <Compile Include="*.cs" />
    <Compile Include="../../../thirdparty/litenetlib/**/*.cs" />
    <Compile Include="../../../thirdparty/liteentitysystem/**/*.cs" />
    <PackageReference Include="K4os.Compression.LZ4" Version="[1.3.8]" />
    <Reference Include="RefMagic" HintPath="../../../thirdparty/liteentitysystem/ILPart/RefMagic.dll" Private="true" />
    <Analyzer Include="../../../thirdparty/liteentitysystem/AnalyzerBinary/LiteEntitySystemAnalyzer.dll" />
    <None Include="../../../thirdparty/liteentitysystem/ILPart/RefMagic.dll" Pack="true" PackagePath="lib/net10.0" />
    <None Include="../../../thirdparty/liteentitysystem/AnalyzerBinary/LiteEntitySystemAnalyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    <None Include="../../../thirdparty/liteentitysystem/LICENSE" Pack="true" PackagePath="licenses/LiteEntitySystem" />
    <None Include="../../../thirdparty/liteentitysystem/NOTICE" Pack="true" PackagePath="licenses/LiteEntitySystem" />
    <None Include="../../../thirdparty/litenetlib/LICENSE.txt" Pack="true" PackagePath="licenses/LiteNetLib" />
  </ItemGroup>
  <Target Name="CopyEGPPackage" AfterTargets="Pack">
    <Copy SourceFiles="$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg"
          DestinationFolder="../../../bin/GodotSharp/Tools/nupkgs/" />
    <Copy SourceFiles="$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg"
          DestinationFolder="$(PushNuGetToLocalSource)" Condition="'$(PushNuGetToLocalSource)' != ''" />
  </Target>
</Project>
