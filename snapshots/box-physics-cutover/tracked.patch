-void SixDOFConstraint::UpdateTranslationLimits()
-{
-	// Set to zero if the limits are inversed
-	for (int i = EAxis::TranslationX; i <= EAxis::TranslationZ; ++i)
-		if (mLimitMin[i] > mLimitMax[i])
-			mLimitMin[i] = mLimitMax[i] = 0.0f;
