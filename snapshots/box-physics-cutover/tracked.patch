-	// Get first child bounds
-	GetChildBounds(0, outBounds);
-
-	// Encapsulate other child bounds
-	for (int child_idx = 1; child_idx < 4; ++child_idx)
-	{
-		AABox tmp;
-		GetChildBounds(child_idx, tmp);
-		outBounds.Encapsulate(tmp);
-	}
