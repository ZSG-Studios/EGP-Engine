cmake_minimum_required(VERSION 3.20)
project(@NAME@ LANGUAGES CXX)
if(NOT EXISTS "${EGP_CPP_SDK}/CMakeLists.txt")
    message(FATAL_ERROR "Build this extension from the EGP editor, or pass -DEGP_CPP_SDK=<extracted SDK path>.")
endif()
add_subdirectory("${EGP_CPP_SDK}" "${CMAKE_CURRENT_BINARY_DIR}/sdk")
add_library(egp_extension_@NAME@ SHARED src/extension.cpp)
target_link_libraries(egp_extension_@NAME@ PRIVATE egp_godot_cpp)
set_target_properties(egp_extension_@NAME@ PROPERTIES PREFIX "" CXX_VISIBILITY_PRESET hidden
    OUTPUT_NAME "@NAME@.@PLATFORM@.$<IF:$<CONFIG:Debug>,debug,release>.@ARCH@"
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/bin"
    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/bin"
    RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_CURRENT_SOURCE_DIR}/bin"
    RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_CURRENT_SOURCE_DIR}/bin")
