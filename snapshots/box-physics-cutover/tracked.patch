-		mMaxSize = 0;
-		mLoadLeft = 0;
-
-		// Allocate new table
-		AllocateTable(inNewMaxSize);
-
-		// Reset all control bytes
-		memset(mControl, cBucketEmpty, mMaxSize + 15);
