-		return;
-
-	// Check if the point is inside the plane
-	if (mPlane.SignedDistance(inPoint) < 0.0f)
-		ioCollector.AddHit({ TransformedShape::sGetBodyID(ioCollector.GetContext()), inSubShapeIDCreator.GetID() });
