-void VehicleEngine::ApplyTorque(float inTorque, float inDeltaTime)
-{
-	// Accelerate engine using torque
-	mCurrentRPM += cAngularVelocityToRPM * inTorque * inDeltaTime / mInertia;
-	ClampRPM();
