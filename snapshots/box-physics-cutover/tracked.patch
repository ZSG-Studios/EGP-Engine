-bool WheeledVehicleController::AllowSleep() const
-{
-	return mForwardInput == 0.0f								// No user input
-		&& mTransmission.AllowSleep()							// Transmission is not shifting
-		&& mEngine.AllowSleep();								// Engine is idling
-}
