-void StaticCompoundShape::sPartition(uint *ioBodyIdx, AABox *ioBounds, int inNumber, int &outMidPoint)
-{
-	// Handle trivial case
-	if (inNumber <= 4)
-	{
-		outMidPoint = inNumber / 2;
-		return;
-	}
