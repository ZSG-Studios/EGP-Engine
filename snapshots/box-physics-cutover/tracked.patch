-		n.x = radius;
-		n.y = h * 0.5;
-		n.z = 0.0;
-	} else {
-		real_t d = radius / s;
-		n.x = n.x * d;
-		n.y = h * 0.5;
-		n.z = n.z * d;
-	}
-
-	return n;
-}
