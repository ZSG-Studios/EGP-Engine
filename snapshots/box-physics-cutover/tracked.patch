-void WheelWV::Update(uint inWheelIndex, float inDeltaTime, const VehicleConstraint &inConstraint)
-{
-	const WheelSettingsWV *settings = GetSettings();
-
-	// Angular damping: dw/dt = -c * w
-	// Solution: w(t) = w(0) * e^(-c * t) or w2 = w1 * e^(-c * dt)
