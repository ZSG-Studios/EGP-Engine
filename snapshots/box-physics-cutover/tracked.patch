-	// Mask out columns of DOFs that are not allowed
-	Vec3 angular_dofs_mask = Vec3(GetAngularDOFsMask().ReinterpretAsFloat());
-	Vec3 v = Vec3::sAnd(inV, angular_dofs_mask);
