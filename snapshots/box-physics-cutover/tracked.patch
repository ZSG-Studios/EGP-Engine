-			// Asks for the object information.
-			get_session(p_session)->send_message("multiplayer:cache", missing);
-		}
-		return true;
-	} else if (p_message == "multiplayer:cache") {
-		ERR_FAIL_COND_V(p_data.size() % 3, false);
