-{
-	if (mHasLimits || mMotorState != EMotorState::Off || mMaxFrictionForce > 0.0f)
-	{
-		// Calculate world space slider axis
-		mWorldSpaceSliderAxis = inRotation1 * mLocalSpaceSliderAxis1;
-
-		// Calculate slide distance along axis
