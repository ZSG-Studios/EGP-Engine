-		return;
-	}
-
-	/* USE POINT */
-
-	r_amount = 1;
-	r_supports[0] = Vector2(
-			(p_normal.x < 0) ? -half_extents.x : half_extents.x,
-			(p_normal.y < 0) ? -half_extents.y : half_extents.y);
