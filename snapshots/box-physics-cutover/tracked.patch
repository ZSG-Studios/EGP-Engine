-
-	if (!_remove_shape_pair(*overlap, p_other_shape_id, p_self_shape_id)) {
-		return false;
-	}
-
-	if (overlap->shape_pairs.is_empty()) {
-		_notify_body_exited(p_body_id);
-	}
-
-	return true;
-}
