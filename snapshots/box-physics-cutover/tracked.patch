-class CylinderShape::Cylinder final : public Support
-{
-public:
-					Cylinder(float inHalfHeight, float inRadius, float inConvexRadius) :
-		mHalfHeight(inHalfHeight),
-		mRadius(inRadius),
-		mConvexRadius(inConvexRadius)
