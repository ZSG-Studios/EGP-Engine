-real_t combine_bounce(GodotBody3D *A, GodotBody3D *B) {
-	return CLAMP(A->get_bounce() + B->get_bounce(), 0, 1);
-}
-
-real_t combine_friction(GodotBody3D *A, GodotBody3D *B) {
-	return Math::abs(MIN(A->get_friction(), B->get_friction()));
-}
