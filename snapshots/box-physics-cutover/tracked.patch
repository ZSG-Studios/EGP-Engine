-MassProperties SphereShape::GetMassProperties() const
-{
-	MassProperties p;
-
-	// Calculate mass
-	float r2 = mRadius * mRadius;
-	p.mMass = (4.0f / 3.0f * JPH_PI) * mRadius * r2 * GetDensity();
-
-	// Calculate inertia
-	float inertia = (2.0f / 5.0f) * p.mMass * r2;
-	p.mInertia = Mat44::sScale(inertia);
-
-	return p;
-}
