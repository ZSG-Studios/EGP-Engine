config_version=5

[application]
config/name="EGP / SUPERPOS LOCKSTEP LAB"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
# --max-fps 60 paces frames; VSync would quantize a slightly late frame to 30 FPS.
window/vsync/vsync_mode=0

[rendering]

# Render on a separate thread so the main thread is free for simulation and animation.
driver/threads/thread_model=2
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.035,0.055,0.09,1)

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3
