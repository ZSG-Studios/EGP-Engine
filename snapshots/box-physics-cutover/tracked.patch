-				} else if (ret != ENetConnection::EVENT_NONE) {
-					close(); // Error
-				}
-			} while (hosts.has(0) && hosts[0]->check_events(ret, event) > 0);
-		} break;
-		case MODE_MESH: {
-			HashSet<int> to_drop;
-			for (KeyValue<int, Ref<ENetConnection>> &E : hosts) {
-				ENetConnection::Event event;
