-	if (!pending_objects_sleeping.erase_unordered(p_jolt_id) && !pending_objects_awake.erase_unordered(p_jolt_id)) {
-		body_iface.RemoveBody(p_jolt_id);
-	}
-
-	body_iface.DestroyBody(p_jolt_id);
