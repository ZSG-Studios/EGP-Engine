-	Vec3 v0 = mScale2 * inV0 - mSphereCenterIn2;
-	Vec3 v1 = mScale2 * inV1 - mSphereCenterIn2;
-	Vec3 v2 = mScale2 * inV2 - mSphereCenterIn2;
