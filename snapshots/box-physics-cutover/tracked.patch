-DVec3 DVec3::PrepareRoundToInf() const
-{
-	// Float has 23 bit mantissa, double 52 bit mantissa => we lose 29 bits when converting from double to float
-	constexpr uint64 cDoubleToFloatMantissaLoss = (1U << 29) - 1;
