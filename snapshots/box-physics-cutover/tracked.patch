-	Transform2D K;
-	K[0] = K1[0] + K2[0];
-	K[1] = K1[1] + K2[1];
-
-	if (B) {
-		Vector2 r2 = rB - B->get_center_of_mass();
-
-		Transform2D K3;
-		K3[0].x = B->get_inv_inertia() * r2.y * r2.y;
-		K3[1].x = -B->get_inv_inertia() * r2.x * r2.y;
-		K3[0].y = -B->get_inv_inertia() * r2.x * r2.y;
-		K3[1].y = B->get_inv_inertia() * r2.x * r2.x;
