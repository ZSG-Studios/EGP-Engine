-	// RUN TIME PROPERTIES FOLLOW
-
-	// World space hinge axis
-	Vec3						mWorldSpaceHingeAxis;
-
-	// World space sliding direction
-	Vec3						mWorldSpaceSliderAxis;
-
-	// The constraint parts
