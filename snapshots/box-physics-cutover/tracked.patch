-		return _mm_div_ps(mValue, _mm_sqrt_ps(len_sq));
-#else
-	return _mm_blendv_ps(_mm_div_ps(mValue, _mm_sqrt_ps(len_sq)), inZeroValue.mValue, is_zero);
