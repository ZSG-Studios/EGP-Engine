-void ENetMultiplayerPeer::close() {
-	if (!_is_active()) {
-		return;
-	}
-
-	_pop_current_packet();
-
-	for (KeyValue<int, Ref<ENetPacketPeer>> &E : peers) {
-		if (E.value.is_valid() && E.value->get_state() == ENetPacketPeer::STATE_CONNECTED) {
-			E.value->peer_disconnect_now(0);
-		}
