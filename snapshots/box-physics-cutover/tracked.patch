-	__m128 m2 = _mm_mul_ps(bcab, zxyy);
-#ifdef JPH_USE_FMADD
-	__m128 m3 = _mm_fmadd_ps(abca, wwwx, m2);
-#else
-	__m128 m1 = _mm_mul_ps(abca, wwwx);
