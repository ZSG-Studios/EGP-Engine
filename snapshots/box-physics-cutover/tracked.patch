-void ConvexHullBuilder::sMarkAffected(Face *inFace, Faces &ioAffectedFaces)
-{
-	if (std::find(ioAffectedFaces.begin(), ioAffectedFaces.end(), inFace) == ioAffectedFaces.end())
-		ioAffectedFaces.push_back(inFace);
