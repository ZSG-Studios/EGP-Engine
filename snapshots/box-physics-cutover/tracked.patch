-	for (;;)
-	{
-		// Atomically fetch a batch of constraints
-		uint32 constraint_idx = ioStep->mSetupVelocityConstraintsReadIdx.fetch_add(cSetupVelocityConstraintsBatchSize);
-		if (constraint_idx >= num_constraints)
