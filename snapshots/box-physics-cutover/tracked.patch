-	{
-		JPH_ASSERT(v.mVertex[0] != v.mVertex[1] && v.mVertex[0] != v.mVertex[2] && v.mVertex[0] != v.mVertex[3]
-			&& v.mVertex[1] != v.mVertex[2] && v.mVertex[1] != v.mVertex[3]
-			&& v.mVertex[2] != v.mVertex[3], "Volume constraints need 4 different vertices");
