<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository NuGet configuration for EGP managed builds (GodotSharp, Godot.NET.Sdk and
  validator fixtures created inside this tree). It adds nuget.org so restores do not
  depend on machine-wide NuGet settings, and keeps the package cache inside the
  ignored build tree, separate for every checkout and machine. Existing user-level
  sources (for example a local GodotSharp feed) still apply; fixtures that need an
  exact source list write their own NuGet.Config with <clear/>.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".build/nuget/packages" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
